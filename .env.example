# Sao chép file này thành .env rồi sửa theo máy của bạn. File .env KHÔNG được đưa lên Git (đã có trong .gitignore).
# Chỉ cần khai báo những biến khác giá trị mặc định.

# Tên máy chủ SQL Server. Ví dụ: localhost, .\SQLEXPRESS, TEN-MAY\SQLEXPRESS
DB_SERVER=localhost
DB_NAME=VNDataPlatform
DB_DRIVER=ODBC Driver 18 for SQL Server

# yes: đăng nhập bằng tài khoản Windows (khuyên dùng, không cần mật khẩu)
# no : dùng DB_USER và DB_PASSWORD bên dưới
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Chỉ dùng khi DB_TRUSTED_CONNECTION=no
DB_USER=
DB_PASSWORD=
