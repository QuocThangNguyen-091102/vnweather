# Sao chép file này thành .env và điền giá trị thực
# File .env đã được thêm vào .gitignore, không được commit lên git

# Chuỗi kết nối SQL Server (Windows Authentication)
DB_SERVER=localhost
DB_NAME=VNDataPlatform
DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_TRUSTED_CONNECTION=yes  (mặc định dùng Windows Auth, không cần mật khẩu)

# Nếu dùng SQL Server Authentication, bỏ comment 2 dòng dưới:
# DB_USER=sa
# DB_PASSWORD=your_password_here
